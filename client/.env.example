# Leave empty to use Vite dev proxy (/api → localhost:3000), or set explicitly:
# VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=
# Must match server API_KEY when set (embedded in client bundle at build time)
# VITE_API_KEY=
# VITE_USE_MOCK_DATA=true   # frontend-only demo; no backend or database needed
